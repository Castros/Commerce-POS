# Local development — copy to .env and edit
# DO NOT commit .env to git

# --- Postgres (local Docker) ---
POSTGRES_DB=commerce_pos
POSTGRES_USER=commerce_pos
POSTGRES_PASSWORD=commerce_pos_dev_password
DATABASE_URL=postgres://commerce_pos:commerce_pos_dev_password@db:5432/commerce_pos
TEST_DATABASE_URL=postgres://commerce_pos:commerce_pos_dev_password@localhost:5434/commerce_pos_test

# --- Ports ---
API_PORT=4100
WEB_PORT=3100

# --- Auth ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-value

# --- CORS ---
# Comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:3100,http://192.168.1.x:3100

# --- API service token ---
# Used for service-to-service calls (spelling app → commerce POS)
# Generate with: openssl rand -hex 32
COMMERCE_API_TOKEN=replace-with-local-api-token

# --- Demo seed (local only) ---
# Set to true in stage/prod to disable /v1/demo/school
DISABLE_DEMO_SEED=false

# --- Student app integration (optional in local dev) ---
SPELLING_APP_API_URL=http://host.docker.internal:4000
SPELLING_APP_SERVICE_TOKEN=replace-with-service-token

# --- Error tracking (optional in local dev) ---
# Get DSN from sentry.io after creating a Node.js project
SENTRY_DSN=

# --- Payments (Phase 2 — Stripe) ---
# Get keys from dashboard.stripe.com
# Use test keys locally, live keys in production only
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
STRIPE_PUBLISHABLE_KEY=pk_test_replace

# --- Email (Phase 2 — Resend) ---
# Get API key from resend.com
RESEND_API_KEY=re_replace
EMAIL_FROM=no-reply@fransolution.net
